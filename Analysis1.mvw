{ safe_quotes_on }
{ GRAPHIC_FILE_1 = "Analysis1.h3d"}
{ RESULT_FILE_1 = "Analysis1.h3d"}
*Id("HyperWorks", "25.*")
*AnimationSyncPolicy(CLOSEST)
*BeginPalette()
*EndPalette()
*BeginMetaData()
*MetaData("HWFrontEnd", "HWFrontEnd", "UnityHybrid")
*EndMetaData()
*BeginPage() // Page 1
    *IsActive()
    *Name("page1")
    *Title("Analysis Results", On)
    *TitleFont("Noto Sans", 1, 0, 12)
    *Layout(1)
    *BeginAnimator(Static)
        *CurrentPosition(0)
        *NumberOfSteps(4)
        *Increment(Forward, Frame, 1, BounceOff)
    *EndAnimator()
    *WindowIDs(2)
    *BeginWindow(Animation)         // Window 1
        *IsActive()
        *ExportFormat("PNG")
        *AnimationNote("")
        *BeginGraphic()
            *LightInfo(0, 0, 1, 0, 0, 0, 64)
            *RotationAngle(15)
            *BeginModel({GRAPHIC_FILE_1}, "Hyper3D Reader", "1")
                *GlobalProperty("Convert 2nd order elements to 1st order elements", "No")
                *ReaderProperty("Model Organization", "Default")
                *ReaderProperty("Read Systems", "Default")
                *ComplexAnimFilter("mag * cos(wt+phase)")
                *ColorBy("Part")
                *Color("255   0   0")
                *GradientColor("Off")
                *SmallDeformation("Off")
                *PartDisplayAttribute("undefined", "undefined")
                *BeginResult({RESULT_FILE_1}, "Hyper3D Reader")
                    *CurrentSubcase(1, 0)
                    *ReaderProperty("Model Organization", "Default")
                    *ReaderProperty("Read Systems", "Default")
                *EndResult()
                *BeginPart(1, "Orphan-Grids", "PART", 0)
                    *Attribute(Off, IdOff, #cfb760, Opa, Sha, NoL, InFit, InCut, InIso)
                *EndPart()
                *BeginPart(1, "Global", "PART", 0)
                    *Attribute(On, IdOff, #00ffff, Opa, Sha, NoL, InFit, InCut, InIso)
                *EndPart()
                *BeginPart(2, "Global", "PART", 0)
                    *Attribute(On, IdOff, #00ffff, Opa, Sha, NoL, InFit, InCut, InIso)
                *EndPart()
                *BeginPart(3, "Global", "PART", 0)
                    *Attribute(On, IdOff, #00ffff, Opa, Sha, NoL, InFit, InCut, InIso)
                *EndPart()
                *BeginPart(4, "Global", "PART", 0)
                    *Attribute(On, IdOff, #00ffff, Opa, Sha, NoL, InFit, InCut, InIso)
                *EndPart()
                *BeginPart(5, "Global", "PART", 0)
                    *Attribute(On, IdOff, #00ffff, Opa, Sha, NoL, InFit, InCut, InIso)
                *EndPart()
                *BeginPart(6, "Global", "PART", 0)
                    *Attribute(On, IdOff, #00ffff, Opa, Sha, NoL, InFit, InCut, InIso)
                *EndPart()
                *BeginPart(7, "Global", "PART", 0)
                    *Attribute(On, IdOff, #00ffff, Opa, Sha, NoL, InFit, InCut, InIso)
                *EndPart()
                *BeginPart(8, "Global", "PART", 0)
                    *Attribute(On, IdOff, #00ffff, Opa, Sha, NoL, InFit, InCut, InIso)
                *EndPart()
                *BeginPart(9, "Global", "PART", 0)
                    *Attribute(On, IdOff, #00ffff, Opa, Sha, NoL, InFit, InCut, InIso)
                *EndPart()
                *BeginPart(10, "Global", "PART", 0)
                    *Attribute(On, IdOff, #00ffff, Opa, Sha, NoL, InFit, InCut, InIso)
                *EndPart()
                *BeginPart(11, "Global", "PART", 0)
                    *Attribute(On, IdOff, #ffeb7c, Opa, Sha, NoL, InFit, InCut, InIso)
                *EndPart()
                *BeginPart(12, "Global", "PART", 0)
                    *Attribute(On, IdOff, #ffeb7c, Opa, Sha, NoL, InFit, InCut, InIso)
                *EndPart()
                *BeginPart(13, "Global", "PART", 0)
                    *Attribute(On, IdOff, #ffeb7c, Opa, Sha, NoL, InFit, InCut, InIso)
                *EndPart()
                *BeginPart(14, "Global", "PART", 0)
                    *Attribute(On, IdOff, #ffeb7c, Opa, Sha, NoL, InFit, InCut, InIso)
                *EndPart()
                *BeginPart(15, "Global", "PART", 0)
                    *Attribute(On, IdOff, #ffeb7c, Opa, Sha, NoL, InFit, InCut, InIso)
                *EndPart()
                *BeginPart(16, "Global", "PART", 0)
                    *Attribute(On, IdOff, #ffeb7c, Opa, Sha, NoL, InFit, InCut, InIso)
                *EndPart()
                *BeginPart(17, "Global", "PART", 0)
                    *Attribute(On, IdOff, #ffeb7c, Opa, Sha, NoL, InFit, InCut, InIso)
                *EndPart()
                *BeginPart(18, "Global", "PART", 0)
                    *Attribute(On, IdOff, #ffeb7c, Opa, Sha, NoL, InFit, InCut, InIso)
                *EndPart()
                *BeginPart(19, "Global", "PART", 0)
                    *Attribute(On, IdOff, #ffeb7c, Opa, Sha, NoL, InFit, InCut, InIso)
                *EndPart()
                *BeginPart(20, "Global", "PART", 0)
                    *Attribute(On, IdOff, #767676, Opa, Sha, NoL, InFit, InCut, InIso)
                *EndPart()
                *BeginPart(21, "Global", "PART", 0)
                    *Attribute(On, IdOff, #ffbdb9, Opa, Sha, NoL, InFit, InCut, InIso)
                *EndPart()
                *BeginPart(1, "Systems", "SYSTEM", 0)
                    *Attribute(On, IdOff, #b9b9b9, Opa, Sha, NoL, InFit, InCut, InIso)
                *EndPart()
                *BeginGroup("Orphan Nodes", "Off", "Off", "255 255 255", 1, "wire")
                    *BeginSelection(Part, SelectAll, "User_Set", 3)
                        *Add("Orphan-Grids id 1")
                    *EndSelection()
                *EndGroup()
                *BeginMask()
                    *BeginSelection(Part, SelectAll, "User_Set", 0)
                        *Add("Orphan-Grids id 1")
                    *EndSelection()
                *EndMask()
                *BeginDeformed()
                    *ScaleMode("ScaleFactor")
                    *Scale("1.000000 1.000000 1.000000")
                    *ResolvedInSystem(0)
                    *ResultType("Displacement")
                    *UndeformedMode("None")
                    *UndeformedColor("componentcolor")
                    *UndeformedTracking("off")
                *EndDeformed()
                *LayerNumber(0)
            *EndModel()
            *RenderOptions("None", "ClipTransparencyOff")
            *DisplayOptions()
            *BeginNote("On", "Model Info")
                *Transparent("On")
                *AutoHide("Off")
                *AnchorToScreen("On")
                *FillColor("255 255 255")
                *TextColor("  0   0   0")
                *Attach("WINDOW")
                *Position(0.500000, 0.500000)
                *Text("{for (i = 0; i != numpts(window.modeltitlelist); ++i) }\n{window.modelidlist[i]}: {window.modeltitlelist[i]}\n{window.loadcaselist[i]} : {window.simulationsteplist[i]} : {window.framelist[i]}\n{endloop}")
                *Font("Noto Sans", "regular", "regular", 10)
                *Color("  0   0   0")
                *BorderWidth(0)
                *LineToEntity(Stipple)
                *Shape("Rectangle")
                *NoteAlignment("Right")
                *NoteAnchor("Right", "Top")
                *TitleFlag("Yes")
            *EndNote()
            *Preferences(0, 31, 10, 0, 2, 3, 4, TriadOn, 30, "TopToBottom", "Off", "Auto", 30, "Off")
            *CurrentModel(1)
            *BeginSavedView("Current View")
                *ProjectionType("Orthographic")
                *View("0.707107 0.353553 -0.612372 0.000000 -0.707107 0.353553 -0.612372 0.000000 0.000000 0.866025 0.500000 0.000000 0.000000 0.000000 0.000000 1.000000")
                *ClippingRegion("-3071.724365 -382.022461 -606.706909 1217.412720 -1738.993896 630.148010")
            *EndSavedView()
        *EndGraphic()
    *EndWindow()
    *TimeScales(1)
    *TimeDelays(0)
    *AnimationEnable(1)
    *SyncTolerance(2e-08)
    *SyncTableGenerationPolicy(ALL_BLOCKS)
    *PageAnimationSyncPolicy(CLOSEST)
*EndPage()
