{ safe_quotes_on }
{ MOD_0 = "TDIM2 42 to 55, t=5.h3d" }
{ RES_0 = "TDIM2 42 to 55, t=5.h3d" }
*Id("HyperWorks", "8.*")
*BeginPage()
    *Title("Analysis Results", On)
    *Layout(1)
    *BeginAnimator(Static)
        *CurrentPosition(0)
        *NumberOfSteps(4)
        *Increment(Forward, Frame, 1, BounceOff)
    *EndAnimator()
    *BeginWindow(Animation)
        *BeginGraphic()
            *BeginModel({MOD_0}, "Hyper3D Reader", 1, 1)
                *ResultSource({RES_0}, "Hyper3D Reader", 1, 1)
                *BeginPart(1, "Global", "PART", 1)
                    *Attribute(On, IdOff, 6, Opa, Sha)
                *EndPart()
                *BeginPart(2, "Global", "PART", 2)
                    *Attribute(On, IdOff, 6, Opa, Sha)
                *EndPart()
                *BeginPart(3, "Global", "PART", 3)
                    *Attribute(On, IdOff, 6, Opa, Sha)
                *EndPart()
                *BeginPart(4, "Global", "PART", 4)
                    *Attribute(On, IdOff, 6, Opa, Sha)
                *EndPart()
                *BeginPart(5, "Global", "PART", 5)
                    *Attribute(On, IdOff, 6, Opa, Sha)
                *EndPart()
                *BeginPart(6, "Global", "PART", 6)
                    *Attribute(On, IdOff, 6, Opa, Sha)
                *EndPart()
                *BeginPart(7, "Global", "PART", 7)
                    *Attribute(On, IdOff, 6, Opa, Sha)
                *EndPart()
                *BeginPart(8, "Global", "PART", 8)
                    *Attribute(On, IdOff, 6, Opa, Sha)
                *EndPart()
                *BeginPart(9, "Global", "PART", 9)
                    *Attribute(On, IdOff, 6, Opa, Sha)
                *EndPart()
                *BeginPart(10, "Global", "PART", 10)
                    *Attribute(On, IdOff, 6, Opa, Sha)
                *EndPart()
                *BeginPart(11, "Global", "PART", 11)
                    *Attribute(On, IdOff, 56, Opa, Sha)
                *EndPart()
                *BeginPart(12, "Global", "PART", 12)
                    *Attribute(On, IdOff, 56, Opa, Sha)
                *EndPart()
                *BeginPart(13, "Global", "PART", 13)
                    *Attribute(On, IdOff, 56, Opa, Sha)
                *EndPart()
                *BeginPart(14, "Global", "PART", 14)
                    *Attribute(On, IdOff, 56, Opa, Sha)
                *EndPart()
                *BeginPart(15, "Global", "PART", 15)
                    *Attribute(On, IdOff, 56, Opa, Sha)
                *EndPart()
                *BeginPart(16, "Global", "PART", 16)
                    *Attribute(On, IdOff, 56, Opa, Sha)
                *EndPart()
                *BeginPart(17, "Global", "PART", 17)
                    *Attribute(On, IdOff, 56, Opa, Sha)
                *EndPart()
                *BeginPart(18, "Global", "PART", 18)
                    *Attribute(On, IdOff, 56, Opa, Sha)
                *EndPart()
                *BeginPart(19, "Global", "PART", 19)
                    *Attribute(On, IdOff, 56, Opa, Sha)
                *EndPart()
                *BeginPart(20, "Global", "PART", 20)
                    *Attribute(On, IdOff, 12, Opa, Sha)
                *EndPart()
                *BeginPart(21, "Global", "PART", 21)
                    *Attribute(On, IdOff, 40, Opa, Sha)
                *EndPart()
                *BeginPart(23, "Orphan-Grids", "PART", 0)
                    *Attribute(Off, IdOff, 37, Opa, Sha)
                *EndPart()
                *BeginGroup("Orphan Nodes", "Off", "Off", "255 255 255", 1, "wire")
                    *BeginSelection(Part, SelectAll, "User_Set", 3)
                        *Add("Orphan-Grids id 1")
                    *EndSelection()
                *EndGroup()
                *BeginMask()
                    *BeginSelection(Part, SelectAll, "User_Set", 0)
                        *Add("Orphan-Grids id 1")
                    *EndSelection()
                *EndMask()
            *EndModel()
            *CurrentModel(0)
            *View(Isometric)
        *EndGraphic()
    *EndWindow()
*EndPage()
